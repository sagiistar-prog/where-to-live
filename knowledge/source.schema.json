{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["source_id", "source_title", "source_url", "jurisdiction", "published_at", "effective_from", "valid_until", "topics", "applicability"],
    "properties": {
      "source_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$"},
      "source_title": {"type": "string", "minLength": 1},
      "source_url": {"type": "string", "format": "uri", "pattern": "^https://[^/]+\\.gov\\.cn/"},
      "jurisdiction": {"enum": ["全国", "北京", "上海", "广州", "深圳"]},
      "published_at": {"type": ["string", "null"], "format": "date"},
      "effective_from": {"type": ["string", "null"], "format": "date"},
      "valid_until": {"type": ["string", "null"], "format": "date"},
      "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "applicability": {"type": "string", "minLength": 1},
      "source_kind": {"enum": ["official_publication", "official_case_explainer", "official_safety_guidance"]},
      "required_markers": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "validity_basis": {"type": "string", "minLength": 1},
      "extract_section": {
        "type": "object", "required": ["label", "start", "end"], "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "start": {"type": "string", "minLength": 1},
          "end": {"type": "string", "minLength": 1}
        }
      }
    },
    "additionalProperties": false
  }
}
