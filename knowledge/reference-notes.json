[
  {
    "source_id": "cn-rental",
    "source_title": "住房租赁条例",
    "source_url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/202508/t20250826_4184615.html",
    "retrieved_at": "2026-09-18T05:16:45.373597+00:00",
    "jurisdiction": "全国",
    "text": "签约前核验出租人身份及合法出租权利。合同应写清押金金额、退还时间和可扣减情形。房产部门备案不收费；出租人未办理时，承租人可以办理。",
    "content_kind": "authored_summary",
    "valid_until": null,
    "published_at": null,
    "effective_from": null
  },
  {
    "source_id": "cn-civil",
    "source_title": "民法典租赁合同章",
    "source_url": "https://www.court.gov.cn/zixun/xiangqing/233181.html",
    "retrieved_at": "2026-09-18T05:16:48.356211+00:00",
    "jurisdiction": "全国",
    "text": "维修、转租、退租和租赁期限需要结合合同及民法典核对。正常使用造成的损耗，与因过错造成的损坏应分别处理。超过六个月的租赁应采用书面形式。",
    "content_kind": "authored_summary",
    "valid_until": null,
    "published_at": null,
    "effective_from": null
  },
  {
    "source_id": "bj-rental",
    "source_title": "北京市住房租赁条例",
    "source_url": "https://www.beijing.gov.cn/zhengce/dfxfg/202208/t20220823_2797935.html",
    "retrieved_at": "2026-09-18T05:16:45.433432+00:00",
    "jurisdiction": "北京",
    "text": "北京租赁住房应符合安全和居住要求，厨房、卫生间等非居住空间不得用于居住。住房租赁企业的押金、预付租金和退还期限存在专门规则，不能套用到所有个人房东交易。",
    "content_kind": "authored_summary",
    "valid_until": null,
    "published_at": null,
    "effective_from": null
  },
  {
    "source_id": "bj-funds",
    "source_title": "北京市住房租赁押金托管和租金监管暂行办法",
    "source_url": "https://www.beijing.gov.cn/zhengce/zhengcefagui/202408/t20240801_3764440.html",
    "retrieved_at": "2026-09-18T05:16:55.809453+00:00",
    "jurisdiction": "北京",
    "text": "北京住房租赁企业收取的押金和符合监管条件的预收租金应按规定进入专用账户。用合同备案编号核验资金信息，保留缴款凭证。",
    "content_kind": "authored_summary",
    "valid_until": null,
    "published_at": null,
    "effective_from": null
  },
  {
    "source_id": "bj-pay",
    "source_title": "押金托管和租金监管资金缴纳操作详解",
    "source_url": "https://gjj.beijing.gov.cn/web/zwfw5/386727/543413441/543413444/543423007/index.html",
    "retrieved_at": "2026-09-18T05:16:56.185404+00:00",
    "jurisdiction": "北京",
    "text": "北京合同备案后，租押金系统生成需托管和监管的账单。可由承租人直缴，也可通过企业代缴；先核对备案合同及监管账户，勿仅凭聊天截图付款。",
    "content_kind": "authored_summary",
    "valid_until": null,
    "published_at": null,
    "effective_from": null
  },
  {
    "source_id": "bj-balance",
    "source_title": "租押金余额查询操作详解",
    "source_url": "https://gjj.beijing.gov.cn/web/zwfw5/386727/543413441/543413442/543423029/index.html",
    "retrieved_at": "2026-09-18T05:16:59.122388+00:00",
    "jurisdiction": "北京",
    "text": "北京承租人可通过资金中心网厅或京通查询名下备案合同的监管资金余额与明细。核对合同编号、企业名称和收支记录。",
    "content_kind": "authored_summary",
    "valid_until": null,
    "published_at": null,
    "effective_from": null
  },
  {
    "source_id": "bj-faq",
    "source_title": "租金监管常见问题解答",
    "source_url": "https://gjj.beijing.gov.cn/web/gjjhd/1747335/543413473/543425903/index.html",
    "retrieved_at": "2026-09-18T05:17:06.254521+00:00",
    "jurisdiction": "北京",
    "text": "北京租押金托管查询应以本人备案合同和官方系统为依据。向租赁企业支付前确认哪些款项纳入托管、哪些属于租金监管，并保留账单。",
    "content_kind": "authored_summary",
    "valid_until": null,
    "published_at": null,
    "effective_from": null
  },
  {
